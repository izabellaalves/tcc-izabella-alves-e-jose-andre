# Exemplo de arquivo .env para configurações
# Copie para .env e ajuste conforme necessário

# Timezone (requerido pelo Defects4J)
TZ=America/Los_Angeles

# Python
PYTHONUNBUFFERED=1

# Limites de recursos (ajuste conforme sua máquina)
DOCKER_CPU_LIMIT=4
DOCKER_MEMORY_LIMIT=8G

# Configurações do pipeline (futuro)
# PROJECTS=Lang,Chart
# SKIP_CHECKOUT=false
# DEBUG=false
